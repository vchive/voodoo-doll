# 002 · 模型编剧配置示例
#
# 用法：复制为 .env 并填入真实值，然后 `node --env-file=.env server/index.js`。
# 不要提交 .env（已在 .gitignore 中）。
#
# 三个必需变量齐了才启用模型；缺任何一个都自动回退本地站，
# 服务照常启动，玩法不受影响（002 spec 的 HF-18）。

# ---- 必需 ----

# 网关地址（不要带结尾斜杠）
MODEL_BASE_URL=http://58.220.83.62:23533

# 密钥，格式 Bearer sk-xxxxxxxx。
# 只被服务端读取，永远不会发送到浏览器，也不会写进日志。
MODEL_API_KEY=

# 模型名。网关是聚合的，可选范围很广，例如：
#   claude-opus-5 / claude-opus-4-8   （Anthropic）
#   gpt-5.6-sol / gpt-5 / gpt-4o      （OpenAI）
#   gemini-2.5-pro                    （Google）
#   glm-4.5                           （智谱）
#   kimi-k3 / deepseek-chat           （月之暗面 / DeepSeek）
MODEL_NAME=

# ---- 可选 ----

# 端点风格：
#   openai    走 POST /v1/chat/completions（默认，网关主接口）
#   anthropic 走 POST /v1/messages（Anthropic 原生）
# MODEL_API_STYLE=openai

# 调用超时毫秒，默认 8000（002 spec 规定的默认值）
# MODEL_TIMEOUT_MS=8000

# 每日模型调用上限，默认 300。达到后回退本地站，不报错。
# MODEL_DAILY_LIMIT=300

# Python World Kernel prerelease boundary.
# WORLD_DB_PATH=data/world.sqlite3
# WORLD_HOST=0.0.0.0
# WORLD_PORT=8000
# WORLD_COOKIE_SECURE=1
# WORLD_MAX_BODY_BYTES=1048576
# WORLD_ALLOWED_ORIGINS=https://game.example.com
# WORLD_ADMIN_TOKEN=
# WORLD_STATIC_DIR=./dist-hex

# 服务端口，默认 8080
# PORT=8080

# 静态资源目录，默认 dist-hex
# DIST_DIR=./dist-hex

# 开发时前端代理指向的服务端地址（hex/vite.config.js 用）
# API_TARGET=http://localhost:8080
