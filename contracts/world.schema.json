{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voodoo-doll.local/contracts/world.schema.json",
  "title": "Voodoo Doll World Contracts",
  "type": "object",
  "definitions": {
    "PlayerTurn": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "actor": {"const": "YOU"},
        "action": {"enum": ["ask", "tell", "invite", "move", "use", "observe"]},
        "target": {"type": "string", "pattern": "^[A-Z]$"},
        "targets": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z]$"}},
        "channel": {"enum": ["public", "private"]},
        "text": {"type": "string", "maxLength": 240},
        "payload": {"type": "object"},
        "expectedVersion": {"type": "integer", "minimum": 0},
        "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 120},
        "turnId": {"type": "string", "maxLength": 120}
      },
      "additionalProperties": true
    },
    "Event": {
      "type": "object",
      "required": ["eventId", "worldVersion", "turnId", "actor", "action", "channel", "payload", "audience", "source"],
      "properties": {
        "eventId": {"type": "string"},
        "worldVersion": {"type": "integer", "minimum": 1},
        "turnId": {"type": "string"},
        "actor": {"enum": ["YOU", "A", "B", "C", "Z", "ENV"]},
        "action": {"type": "string"},
        "target": {"type": ["string", "null"]},
        "channel": {"enum": ["public", "private", "doll_private", "environment", "system"]},
        "payload": {"type": "object"},
        "audience": {"type": "array", "items": {"type": "string"}},
        "source": {"enum": ["player_doll", "local", "pi", "deepseek", "claude", "environment", "system"]},
        "proposalStatus": {"type": "string"},
        "schemaVersion": {"const": 4}
      },
      "additionalProperties": true
    }
  }
}
